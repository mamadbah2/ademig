# Base Neon (fournie par l'intégration Vercel : `vercel env pull .env.local`)
DATABASE_URL=
# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Vercel Blob (médiathèque)
BLOB_READ_WRITE_TOKEN=
# Resend (emails d'invitation et de réinitialisation) — facultatif : sans clé, les liens s'affichent dans le terminal
RESEND_API_KEY=
# Facultatif : expéditeur des emails, une fois le domaine vérifié dans Resend
EMAIL_EXPEDITEUR=
