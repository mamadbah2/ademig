# Base Neon (fournie par l'intégration Vercel : `vercel env pull .env.local`)
DATABASE_URL=
# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Vercel Blob (médiathèque)
BLOB_READ_WRITE_TOKEN=
# Resend (alternative à Gmail) — facultatif : sans service d'email, les liens s'affichent dans le terminal en développement
RESEND_API_KEY=
# Facultatif : expéditeur des emails, une fois le domaine vérifié dans Resend
EMAIL_EXPEDITEUR=
# Gmail (emails d'invitation et de rappel) : adresse et mot de passe d'application Google ; prioritaire sur Resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Quota quotidien de la file d'envoi
EMAILS_PAR_JOUR=150
# Secret du cron Vercel qui vide la file d'envoi
CRON_SECRET=
